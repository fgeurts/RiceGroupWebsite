---
layout: layouts/base.njk
title: "News"
---

<div id="container" style="display: flex; justify-content: space-between; align-items: flex-start;">
  <!-- Main Content Column -->
  <div id="contentContainer" style="flex: 1; min-width: 0; padding-right: 30px;">
    <div id="content">
      <div class="blog-archive-entries-wrapper">
        {% for post in (collections.news | reverse).slice(0, 5) %}
          <div class="blog-entry">
            <h1 class="blog-entry-title">
              <a href="{{ post.url }}">{{ post.data.title }}</a>
            </h1>
            <div class="blog-entry-date">
              {{ post.date | date("%B %d, %Y") }}
            </div>
            <div class="blog-entry-body">
              {{ post.content | safe }}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <!-- Sidebar Column -->
  <div id="sidebarContainer" style="width: 280px; flex-shrink: 0;">
    <div id="sidebar">
      <h1 class="sideHeader">BlueSky Feed</h1>
      <span style="font:12px HelveticaNeue; color:#758695;">
        <script async src="https://bst.heion.net/timeline.js" data-handle="frankgeurts.bsky.social" data-theme="light" data-width="280" data-height="800" data-lang="en" data-pin="0" data-rp="1"></script><br />
      </span>

      <!-- Year-by-Year Archive Links -->
      <div id="blog-archives">
        {% for yearGroup in collections.postsByYear %}
          <a class="blog-archive-link-enabled" href="/news/archive-{{ yearGroup.year }}.html">{{ yearGroup.year }}</a><br />
        {% endfor %}
      </div>

      <div id="blog-rss-feeds">
        <a class="blog-rss-link" href="/news/feed.xml" rel="alternate" type="application/rss+xml" title="Rice Heavy Ions News">RSS Feed</a><br />
      </div>
    </div>
  </div>
</div>