<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="robots" content="index, follow" />
	
	<!-- Social & Twitter Card Metadata -->
	<meta name="twitter:card" content="summary">
	<meta name="twitter:site" content="@frankgeurts (@frankgeurts.bsky.social)">
	<meta name="twitter:creator" content="@frankgeurts (@frankgeurts.bsky.social)">
	<meta name="twitter:title" content="{{ title or 'Rice Heavy Ion Group' }} | Ultrarelativistic Heavy-Ion Physics">
	<meta name="twitter:url" content="https://heavyions.rice.edu{{ page.url }}">
	
	<meta property="og:type" content="website">
	<meta property="og:site_name" content="Ultrarelativistic Heavy-Ion Physics">
	<meta property="og:title" content="{{ title or 'Rice Heavy Ion Group' }} | Ultrarelativistic Heavy-Ion Physics">
	<meta property="og:url" content="https://heavyions.rice.edu{{ page.url }}">
	
	<title>{{ title or 'Ultrarelativistic Heavy-Ion Physics' }} | Rice Heavy Ion Group</title>
	
	<!-- Stylesheets -->
	<link rel="stylesheet" type="text/css" media="all" href="/assets/css/consolidated.css" />
	
	<!-- Google Analytics -->
	<script>
	  (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
	  (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
	  m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
	  })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');

	  ga('create', 'UA-85637479-1', 'auto');
	  ga('send', 'pageview');
	</script>
</head>
<body>
	<div id="topbar"></div>
	
	<div id="pageHeader">
		<div id="title">
			<h1>Ultrarelativistic Heavy-Ion Physics</h1>
			<h2>Prof. Frank Geurts</h2>
		</div>
		
		<!-- Navigation Partial -->
		{% include "partials/nav.njk" %}
	</div>
	
	<div id="headerBottomGrad">
		<img src="/assets/img/bottom_grad.png" alt="" style="width: 3000px; height: 12px;" />
	</div>

	<div id="container">
		<div id="sidebarContainer">
			<div id="sidebar">
				<h1 class="sideHeader">{{ sideHeader | default("") }}</h1>
				{% if sidebarExtra %}
					{{ sidebarExtra | safe }}
				{% endif %}
			</div>
		</div>
		
		<div id="contentContainer">
			<div id="content">
				<!-- Page Content Injected Here -->
				{{ content | safe }}
			</div>
			<div class="clearer"></div>
			<div id="breadcrumbcontainer"></div>
		</div>

		<div id="footer">
			<p>&copy; {% year %} Geurts</p>
		</div>
	</div>
	
	<div id="footerBottomGrad">
		<img src="/assets/img/bottom_grad.png" alt="" style="width: 3000px; height: 12px;" />
	</div>
</body>
</html>
